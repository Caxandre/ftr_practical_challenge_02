generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // trocar para "postgresql" se optar por Postgres
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories   Category[]
  transactions Transaction[]
}

// Nota: o conector SQLite do Prisma não suporta `enum` nativo (P1012).
// CategoryColor ("GRAY"|"BLUE"|"PURPLE"|"PINK"|"RED"|"ORANGE"|"YELLOW"|"GREEN")
// e TransactionType ("INCOME"|"EXPENSE") são validados via Zod na camada de
// serviço (src/modules/**/*.schema.ts) e continuam como enum no schema GraphQL.
model Category {
  id           String        @id @default(uuid())
  name         String
  description  String?
  color        String        @default("GRAY")
  icon         String
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
}

model Transaction {
  id          String   @id @default(uuid())
  description String
  amount      Int // sempre em centavos, sempre positivo (o sinal vem de `type`)
  type        String
  date        DateTime
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([categoryId])
}
